# In secrets.yaml umbenennen (bzw. die Zeilen in die vorhandene secrets.yaml
# des ESPHome-Ordners übernehmen) und eigene Werte eintragen.
# Die echte secrets.yaml gehört nicht ins Repository.

wifi_ssid: "MeinWLAN"
wifi_password: "MeinWLANPasswort"

# API-Schlüssel: 32 Byte, Base64 – z. B. von https://esphome.io/components/api/ erzeugen lassen
ofen_display_tisch__encryption_key: "BITTE-EIGENEN-SCHLUESSEL-EINTRAGEN="
ofen_display_tisch__ap_password: "eigenes-hotspot-passwort"
